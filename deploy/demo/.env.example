# Copy to .env (setup.sh does it). No secrets here: passwords and the data key
# live in secrets/ (generated by setup.sh); the values below are filled in by you.

# Image tag from ghcr.io/inner-savages/silence-on-the-wire/console (latest = main).
SOTW_TAG=latest

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
TUNNEL_TOKEN=

# Shared bearer token for POST /events and /logs. setup.sh generates it.
ASI_CENTRAL_TOKEN=

# Console accounts. Self-registration is OFF; the admin is created from
# secrets/admin_password on first start. Set ASI_VIEWER_LOGIN to also create
# a read-only account (role "viewer") with secrets/viewer_password.
ASI_ALLOW_REGISTRATION=false
ASI_ADMIN_LOGIN=admin
ASI_VIEWER_LOGIN=jury

# Optional external lookups (read from the environment only).
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
NVD_API_KEY=
ASI_AI_BASE_URL=
ASI_AI_API_KEY=
ASI_AI_MODEL=

# Fleet size of the synthetic demo data.
DEMO_FLEET=137
